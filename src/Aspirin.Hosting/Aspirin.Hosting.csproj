<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Aspire's pipeline APIs are experimental: ASPIREPIPELINES001 (steps) and ASPIREPIPELINES004 (output directory). -->
    <NoWarn>$(NoWarn);ASPIREPIPELINES001;ASPIREPIPELINES004</NoWarn>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts\*" LogicalName="%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Aspirin.Hosting.Tests" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
